{
  "manifest_version": 3,
  "name": "StudyPilot Live",
  "version": "0.1.0",
  "description": "Live screen-aware academic coaching with Gemini Live (ephemeral token via Supabase).",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "wss://generativelanguage.googleapis.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/panel.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "StudyPilot Live"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-worklet.js", "offscreen.html", "config.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
