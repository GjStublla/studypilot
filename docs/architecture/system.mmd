%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#f3effa", "primaryTextColor": "#20152e", "primaryBorderColor": "#6f35a5", "lineColor": "#5f556b", "secondaryColor": "#eef6ff", "tertiaryColor": "#f7f8fa", "fontFamily": "Arial, sans-serif"}, "flowchart": {"curve": "basis", "nodeSpacing": 42, "rankSpacing": 56}}}%%
flowchart LR
  subgraph CLIENTS[Student-facing clients]
    direction TB
    EXT[Chrome MV3 extension<br/>on-page coaching and Live audio]
    WEB[React dashboard<br/>rubrics, chats, sessions, and actions]
  end

  BOUNDARY[Browser trust boundary<br/>public config and user JWT only]

  subgraph SERVICES[Authenticated application services]
    direction TB
    AUTH[Supabase Auth]
    API[FastAPI<br/>authenticated CRUD]
    EDGE[Supabase Edge Functions<br/>chat, RAG, coaching, and Live token]
  end

  subgraph DATA[Protected data and managed dependencies]
    direction TB
    DB[(Supabase Postgres<br/>RLS-protected user data)]
    STORAGE[(Supabase Storage<br/>opt-in session captures)]
    RT[Supabase Realtime<br/>cross-surface events]
    VERTEX[Vertex AI / Gemini<br/>server-side invocation]
  end

  EXT --> BOUNDARY
  WEB --> BOUNDARY
  BOUNDARY -->|sign in| AUTH
  BOUNDARY -->|profile, session, rubric, action CRUD| API
  BOUNDARY -->|authenticated chat, RAG, and Live| EDGE
  BOUNDARY -.->|subscribe to chat and session updates| RT

  AUTH --> DB
  API --> DB
  EDGE --> DB
  EDGE --> STORAGE
  EDGE --> VERTEX
  EDGE -->|publish events| RT

  classDef client fill:#f3effa,stroke:#6f35a5,stroke-width:2px,color:#20152e;
  classDef boundary fill:#fff4df,stroke:#b56b16,stroke-width:2px,color:#39230d;
  classDef service fill:#eef6ff,stroke:#2d6ea6,stroke-width:2px,color:#13283a;
  classDef data fill:#eff8f1,stroke:#3d7d4c,stroke-width:2px,color:#18301e;
  class EXT,WEB client;
  class BOUNDARY boundary;
  class AUTH,API,EDGE,RT service;
  class DB,STORAGE,VERTEX data;
