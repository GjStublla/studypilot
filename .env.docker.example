# Environment reference for the Docker setup.
#
# Docker reads TWO env files:
#   1. ./.env          -> frontend (VITE_* vars) — see .env.example
#   2. ./backend/.env  -> backend (Supabase server keys) — see backend/.env.example
#
# Copy .env.example -> .env and backend/.env.example -> backend/.env, then fill in
# your hosted Supabase values. The notes below cover only the Docker-specific bits.

# ---------------------------------------------------------------------------
# Frontend (./.env) — used by both dev and prod compose
# ---------------------------------------------------------------------------
# Dev: the browser reaches the backend on the host, so loopback is OK.
# Production compose (docker-compose.prod.yml) has no localhost defaults:
# VITE_API_BASE_URL and VITE_SUPABASE_URL must be public HTTPS URLs. The
# Docker/Vite production build fails closed if they are missing or loopback.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Backend (./backend/.env)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Optional: extra allowed CORS origins (comma-separated). Needed when testing
# the prod frontend served by nginx on port 8080.
# CORS_ORIGINS=http://localhost:8080
