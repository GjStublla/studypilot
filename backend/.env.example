# Copy this file to backend/.env and fill in the values from the Supabase dashboard.
# backend/.env is gitignored — never commit real keys.

# Supabase Project Settings → API → Project URL
SUPABASE_URL=

# Supabase Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=

# Supabase Project Settings → API → Project API keys → service_role (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key (used by the live-token edge function, not the FastAPI server)
GEMINI_API_KEY=
