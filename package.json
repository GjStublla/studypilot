{
  "name": "studypilot-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "vite --host 127.0.0.1 --mode studypilot-local",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deno": "npx --yes deno@2.1.4 test --allow-env supabase/functions",
    "local:start": "supabase start",
    "local:stop": "supabase stop",
    "local:status": "supabase status -o env",
    "local:functions": "supabase functions serve --env-file supabase/functions/.env.local",
    "backend": "cd backend && python -m uvicorn main:app --reload",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "verify:functions": "node scripts/verify-function-allowlist.mjs",
    "verify:built-env": "node scripts/verify-built-env.mjs dist",
    "verify:release": "node scripts/verify-release.mjs",
    "extension:build": "npm run build --prefix ../studypilot-extension"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^5.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "supabase": "2.110.0",
    "vitest": "^4.1.10"
  }
}
