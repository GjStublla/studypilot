# Copy to `.env.local` in this directory for local Edge Function development.
# Never commit real service-account credentials or API keys.
# Give each developer a separate least-privilege service account; do not share
# one private key across the team. Run `npm run local:check` after editing.

AI_USAGE_LIMITS_DISABLED=true

# --- Vertex AI only (required for all Gemini production paths) ---
# Text / Interactions / RAG / Live use service-account OAuth — no GEMINI_API_KEY.
# GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY  OR  GEMINI_SERVICE_ACCOUNT_CREDENTIALS
GOOGLE_PROJECT_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Paste the downloaded service-account JSON on one line, preferably wrapped in
# single quotes so its double quotes and escaped newlines are preserved.
GEMINI_SERVICE_ACCOUNT_CREDENTIALS=
# Vertex Interactions / Live location (default global).
VERTEX_LOCATION=us-central1
# Vertex RAG Engine is regional (not global). Default us-west1 (avoids
# Spanner capacity restrictions on new GCP projects in us-central1).
VERTEX_RAG_LOCATION=us-west1
# --- Optional / unused by production Edge paths ---
# GEMINI_API_KEY=   # Google AI Studio only; not required for StudyPilot Vertex-only

# Model overrides (defaults shown). Text/RAG uses a project-enabled Vertex model.
# Live uses gemini-3.1-flash-live-preview (3.5 Flash does not support the Live API).
# Retired Gemini aliases are remapped to the stable text fallback.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_RAG_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
