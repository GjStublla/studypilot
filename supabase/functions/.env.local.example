# Copy to `.env.local` in this directory for local Edge Function development.
# Never commit real service-account credentials or API keys.

AI_USAGE_LIMITS_DISABLED=true

# --- Vertex AI only (required for all Gemini production paths) ---
# Text / Interactions / RAG / Live use service-account OAuth — no GEMINI_API_KEY.
# GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY  OR  GEMINI_SERVICE_ACCOUNT_CREDENTIALS
GOOGLE_PROJECT_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
GEMINI_SERVICE_ACCOUNT_CREDENTIALS=
# Vertex Interactions / Live location (default global).
VERTEX_LOCATION=global
# Vertex RAG Engine is regional (not global). Default us-central1.
VERTEX_RAG_LOCATION=us-central1
# Optional override for a project-verified Vertex model id
# VERTEX_MODEL=gemini-3.5-flash

# --- Optional / unused by production Edge paths ---
# GEMINI_API_KEY=   # Google AI Studio only; not required for StudyPilot Vertex-only

# Model overrides (defaults shown). Vertex serves gemini-3.5-flash for text/RAG;
# Edge does not rewrite it to gemini-3-flash-preview (that is a different preview id).
# Live uses gemini-3.1-flash-live-preview (3.5 Flash does not support the Live API).
# Retired gemini-2.0-* / gemini-1.5-* aliases are remapped to gemini-3.5-flash.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_RAG_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
