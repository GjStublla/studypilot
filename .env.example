# Frontend environment variables — read by Vite at build/dev time.
# These are the ONLY vars the browser may use. Never put server secrets here.
#
# backend/.env holds the server-side keys (service role, Gemini, etc.)
# This file holds the public-facing frontend keys only.

# FastAPI backend base URL (leave blank to use the http://localhost:8000 fallback)
VITE_API_BASE_URL=

# Supabase Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=
