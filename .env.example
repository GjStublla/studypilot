# Frontend environment variables — read by Vite at build/dev time.
# These are the ONLY vars the browser may use. Never put server secrets here.
#
# backend/.env holds the server-side keys (service role, Vertex/Gemini, etc.)
# This file holds the public-facing frontend keys only.
#
# Production (`npm run build`, Docker prod image):
#   VITE_API_BASE_URL and VITE_SUPABASE_URL must be public HTTPS URLs.
#   Loopback, private, and http:// hosts fail the build. Values are never logged.
#   VITE_SUPABASE_ANON_KEY must be present and JWT-shaped. It is public; still
#   do not paste hosted keys into logs, screenshots, or the demo video.
#   VITE_CHROME_STORE_URL is optional and is not required for a production web build.
#
# Local Vite (`npm run dev` / `npm run dev:local`):
#   http://127.0.0.1 and http://localhost are allowed only in explicit local mode
#   (`--mode studypilot-local`, see .env.studypilot-local). Ordinary `vite build`
#   is always treated as production.

# FastAPI backend base URL (required public HTTPS URL for production builds)
VITE_API_BASE_URL=

# Supabase Project Settings → API → Project URL (required public HTTPS URL for production builds)
VITE_SUPABASE_URL=

# Supabase Project Settings → API → Project API keys → anon / public (required for production builds)
VITE_SUPABASE_ANON_KEY=

# Optional public Chrome Web Store listing. Must be an https://chromewebstore.google.com/ URL.
# Leave empty during invite-only beta; the site will show a disabled install control.
VITE_CHROME_STORE_URL=
